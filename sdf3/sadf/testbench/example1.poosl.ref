system specification SADF
behaviour specification
(Kernel0:Kernel0(true, 1, false, "A")[DI0/DO0, DI5/DO5, DO1/DI1, Monitor/Monitor] ||
Kernel1:Kernel1(true, 2, false, "B")[DI1/DO1, DI2/DO2, DO0/DI0, DO4/DI4, CO0/CI0, Monitor/Monitor] ||
Kernel2:Kernel2(true, 3, false, "C")[DI3/DO3, DO2/DI2, CO1/CI1, Monitor/Monitor] ||
Kernel3:Kernel3(true, 4, false, "D")[DI4/DO4, DO3/DI3, CO2/CI2, Monitor/Monitor]||
Detector0:Detector0(true, 5, false, "E")[CI0/CO0, CI1/CO1, CI2/CO2, DO5/DI5, Monitor/Monitor] ||
DataBuffer0:DataBuffer(-1, 0, 1, false, nil, false, "A2B")[DI0/In, DO0/Out, Monitor/Monitor] ||
DataBuffer1:DataBuffer(-1, 2, 1, false, nil, false, "B2A")[DI1/In, DO1/Out, Monitor/Monitor] ||
DataBuffer2:DataBuffer(-1, 0, 1, false, nil, false, "B2C")[DI2/In, DO2/Out, Monitor/Monitor] ||
DataBuffer3:DataBuffer(-1, 0, 1, false, nil, false, "C2D")[DI3/In, DO3/Out, Monitor/Monitor] ||
DataBuffer4:DataBuffer(-1, 3, 1, false, nil, false, "D2B")[DI4/In, DO4/Out, Monitor/Monitor] ||
DataBuffer5:DataBuffer(-1, 0, 1, false, nil, false, "A2E")[DI5/In, DO5/Out, Monitor/Monitor] ||
ControlBuffer0:ControlBuffer(-1, new(Queue) init, new(Queue) init, 1, false, nil, false, "E2B")[CI0/In, CO0/Out, Monitor/Monitor] ||
ControlBuffer1:ControlBuffer(-1, new(Queue) init, new(Queue) init, 1, false, nil, false, "E2C")[CI1/In, CO1/Out, Monitor/Monitor] ||
ControlBuffer2:ControlBuffer(-1, new(Queue) init, new(Queue) init, 1, false, nil, false, "E2D")[CI2/In, CO2/Out, Monitor/Monitor] ||
SimulationController:SimulationController(5, "results.log")[Monitor/Monitor]
)\{DI0, DO0, DI1, DO1, DI2, DO2, DI3, DO3, DI4, DO4, DI5, DO5, CI0, CO0, CI1, CO1, CI2, CO2, Monitor}

process class Kernel0(Monitor: Boolean, MonitorID: Integer, Trace: Boolean, Name: String)
instance variables
ExecutionTimes: Array, Status: ProcessMonitor


initial method call
Initialise()()

instance methods
Initialise()() |Distribution: GeneralDiscrete|

ExecutionTimes := new(Array) size(1);
Distribution := new(GeneralDiscrete)
   withParameters(2, 0.5)
   withParameters(2.1, 0.5);
ExecutionTimes put(1, Distribution);
Status := new(ProcessMonitor) init(Monitor, MonitorID, Trace, Name);
abort
   par Fire()() and if Monitor then CheckAccuracyStatus()() fi rap
with Monitor?StopSimulation; if Monitor then Monitor!Results(Status getResults) fi.

CheckAccuracyStatus()() |ID: Integer|

Monitor?Status(ID | ID = MonitorID);
Monitor!AccuracyStatus(MonitorID, Status accurate);
CheckAccuracyStatus()().

Fire()() |Scenario: Integer|

Scenario := 0;
DI1!Inspect(2);
DO0!Room(2);
DO5!Room(1);
DO0!Reserve;
DO5!Reserve;
Status start(currentTime);
delay(ExecutionTimes get(Scenario + 1) sample);
Status end(currentTime);
DI1!Read;
DO0!Write;
DO5!Write;
Fire()().

process class Kernel1(Monitor: Boolean, MonitorID: Integer, Trace: Boolean, Name: String)
instance variables
ExecutionTimes: Array, Status: ProcessMonitor


initial method call
Initialise()()

instance methods
Initialise()() |Distribution: GeneralDiscrete|

ExecutionTimes := new(Array) size(2);
Distribution := new(GeneralDiscrete)
   withParameters(3, 0.2)
   withParameters(2.8, 0.8);
ExecutionTimes put(1, Distribution);
Distribution := new(GeneralDiscrete)
   withParameters(4, 1);
ExecutionTimes put(2, Distribution);
Status := new(ProcessMonitor) init(Monitor, MonitorID, Trace, Name);
abort
   par Fire()() and if Monitor then CheckAccuracyStatus()() fi rap
with Monitor?StopSimulation; if Monitor then Monitor!Results(Status getResults) fi.

CheckAccuracyStatus()() |ID: Integer|

Monitor?Status(ID | ID = MonitorID);
Monitor!AccuracyStatus(MonitorID, Status accurate);
CheckAccuracyStatus()().

Fire()() |Scenario: Integer|

CI0!Inspect;
CI0?Scenario(Scenario);
if Scenario = 0 then
   DI0!Inspect(2);
   DI4!Inspect(2);
   DO1!Room(2);
   DO2!Room(3);
   DO1!Reserve;
   DO2!Reserve;
   Status start(currentTime);
   delay(ExecutionTimes get(Scenario + 1) sample);
   Status end(currentTime);
   DI0!Read;
   DI4!Read;
   DO1!Write;
   DO2!Write
fi;
if Scenario = 1 then
   DI0!Inspect(1);
   DI4!Inspect(2);
   DO1!Room(1);
   DO2!Room(2);
   DO1!Reserve;
   DO2!Reserve;
   Status start(currentTime);
   delay(ExecutionTimes get(Scenario + 1) sample);
   Status end(currentTime);
   DI0!Read;
   DI4!Read;
   DO1!Write;
   DO2!Write
fi;
CI0!Read;
Fire()().

