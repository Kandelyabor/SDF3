data class Distribution
extends Object
instance variables
Random: RandomGenerator

instance methods
initialise : Distribution

  Random := new(RandomGenerator) randomiseSeed;
  return(self).

data class Uniform
extends Distribution
instance variables
IntervalLength: Real, LowerBound: Real

instance methods
withParameters(LB, UB: Real) : Uniform

   self initialise;
   LowerBound := LB; IntervalLength := UB - LB;
   return(self).

sample : Real

   return(LowerBound + (Random random * IntervalLength)).

data class GeneralDiscrete
extends Distribution
instance variables
UpperBounds: Array, LowerBounds: Array, Weights: Array, SampleValues: Array

instance methods
withParameters(Value: Object, Weight: Real) : GeneralDiscrete |Index, Size: Integer, CumulativeWeight, Total: Real|

if Random = nil then
    self initialise;
    SampleValues := new(Array);
    Weights := new(Array);
    LowerBounds := new(Array);
    UpperBounds := new(Array)
fi;
Size := SampleValues getSize + 1;
SampleValues size(Size);
SampleValues put(Size, Value);
Weights size(Size);
Weights put(Size, Weight);
LowerBounds size(Size);
UpperBounds size(Size);
Index := 1; Total := 0.0;
while Index <= Size do
   Total := Total + Weights get(Index);
   Index := Index + 1
od;
Index := 1; CumulativeWeight := 0.0;
while Index <= Size do
    LowerBounds put(Index, CumulativeWeight/Total);
    CumulativeWeight := CumulativeWeight + Weights get(Index);
    UpperBounds put(Index, CumulativeWeight/Total);
    Index := Index + 1
od;
return self.

sample() : Object |Sample: Real, Result : Object, Index: Integer|

Sample := Random random;
Index := 1;
while Result = nil do
   if (LowerBounds get(Index) < Sample) & (Sample <= UpperBounds get(Index)) then Result := SampleValues get(Index) else Index := Index + 1 fi
od;
return Result.

data class Queue
extends Object
instance variables
PrimairElement: QueueElement, Occupation: Integer

instance methods
init : Queue

   PrimairElement := new(QueueElement);
   PrimairElement setNext(PrimairElement) setPrevious(PrimairElement);
   Occupation := 0;
   return(self).

put(NewElement: Object) : Object |NQE: QueueElement|

   NQE := new(QueueElement) setElement(NewElement);
   NQE setNext(PrimairElement getNext) setPrevious(PrimairElement);
   PrimairElement setNext(NQE);
   NQE getNext setPrevious(NQE);
   Occupation := Occupation + 1;
   return(self).

inspect : Object |QE: QueueElement|

   QE := PrimairElement getPrevious;
   return(QE getElement).

remove : Object |QE: QueueElement|

   QE := PrimairElement getPrevious;
   QE getNext setPrevious(QE getPrevious);
   QE getPrevious setNext(QE getNext);
   Occupation := Occupation - 1;
   return(QE getElement).

isNotEmpty : Boolean

   return(Occupation != 0).

data class QueueElement
extends Object
instance variables
Next: QueueElement, Element: Object, Previous: QueueElement

instance methods
setNext(QE: QueueElement): QueueElement

   Next := QE;
   return(self).

getPrevious: QueueElement

   return(Previous).

setElement(E: Object): QueueElement

   Element := E;
   return(self).

getElement: Object

   return(Element).

getNext: QueueElement

   return(Next).

setPrevious(QE: QueueElement): QueueElement

   Previous := QE;
   return(self).

