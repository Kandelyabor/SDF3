<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SADF: convert SADF to FSMSADF on ce_converted_csdf_strongly_consistent</name>
		<program>sdf3convert-sadf-sadf2fsmsadf --graph ce_converted_csdf_strongly_consistent.xml --output sadf-to-fsmsadf.xml</program>
		<type>xmlcompare</type>
		<programOutput>sadf-to-fsmsadf.xml</programOutput>
	</settings>

</sdf3>