<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SADF: verify connected graph on example1</name>
		<program>sdf3verify-sadf --graph ./example1.xml --check connected_graph</program>
		<type>outputcompare</type>
		<reference>SADF graph 'example1' is connected.</reference>
	</settings>

</sdf3>
