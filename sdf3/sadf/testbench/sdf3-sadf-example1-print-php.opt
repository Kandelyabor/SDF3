<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SADF: print php on example1</name>
		<program>sdf3print-sadf --graph ./example1.xml --format php --output example1.php</program>
		<type>outputcompare</type>
		<programOutput>example1.php</programOutput>
	</settings>

</sdf3>
