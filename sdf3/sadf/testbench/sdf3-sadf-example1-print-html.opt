<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SADF: print html on example1</name>
		<program>sdf3print-sadf --graph ./example1.xml --format html --output example1.html</program>
		<type>outputcompare</type>
		<programOutput>example1.html</programOutput>
	</settings>

</sdf3>
