<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SADF: compute expected response delay on example1</name>
		<program>sdf3analyze-sadf --graph example1.xml --compute response_delay(expected)</program>
		<type>outputcompare</type>
		<reference>---- Expected response delay of all processes for SADF graph 'example1' ----
Kernel 'A': 2.05  (#States: 2, Analysis Time: 0ms)
Kernel 'B': 6.05  (#States: 2, Analysis Time: 0ms)
Kernel 'C': 9.05  (#States: 2, Analysis Time: 0ms)
Kernel 'D': 11.55  (#States: 2, Analysis Time: 0ms)
Detector 'E': 2.05  (#States: 2, Analysis Time: 0ms)</reference>
		<ignore>Analysis Time: .*ms</ignore>
	</settings>
</sdf3>
