<?xml version='1.0' encoding='UTF-8'?>
<sdf3 type='sadf' version='1.0' xmlns:xsi='https://www.w3.org/2001/XMLSchema-instance' xmlns='uri:sadf' xsi:schemaLocation='uri:sadf https://www.es.ele.tue.nl/sadf/sdf3-sadf.xsd'>

<sadf name='example'>

<structure>
  <detector name='a'/>
  <detector name='b'/>
  <detector name='c'/>
  <channel name='alpha' type='data' source='a' destination='b'/>
  <channel name='beta' type='data' source='b' destination='c'/>
  <channel name='d1' type='data' source='a' destination='a'/>
  <channel name='d2' type='data' source='b' destination='b'/>
  <channel name='d3' type='data' source='c' destination='c'/>
</structure>

<properties>
  <detector_properties detector='a'>
    <subscenario name='Phase0'>
      <consume channel='d1' tokens='1'/>
      <produce channel='alpha' tokens='3'/>
      <produce channel='d1' tokens='1'/>
      <profile execution_time='1'/>
    </subscenario>
    <subscenario name='Phase1'>
      <consume channel='d1' tokens='1'/>
      <produce channel='alpha' tokens='1'/>
      <produce channel='d1' tokens='1'/>
      <profile execution_time='3'/>
    </subscenario>
    <markov_chain initial_state='Phase1'>
      <state name='Phase0' subscenario='Phase0'>
        <transition destination='Phase1' weight='1'/>
      </state>
      <state name='Phase1' subscenario='Phase1'>
        <transition destination='Phase0' weight='1'/>
      </state>
    </markov_chain>
  </detector_properties>

  <detector_properties detector='b'>
    <subscenario name='Phase0'>
      <consume channel='alpha' tokens='4'/>
      <consume channel='d2' tokens='1'/>
      <produce channel='beta' tokens='2'/>
      <produce channel='d2' tokens='1'/>
      <profile execution_time='2'/>
    </subscenario>
    <subscenario name='Phase1'>
      <consume channel='alpha' tokens='2'/>
      <consume channel='d2' tokens='1'/>
      <produce channel='beta' tokens='4'/>
      <produce channel='d2' tokens='1'/>
      <profile execution_time='2'/>
    </subscenario>
    <markov_chain initial_state='Phase1'>
      <state name='Phase0' subscenario='Phase0'>
        <transition destination='Phase1' weight='1'/>
      </state>
      <state name='Phase1' subscenario='Phase1'>
        <transition destination='Phase0' weight='1'/>
      </state>
    </markov_chain>
  </detector_properties>

  <detector_properties detector='c'>
    <subscenario name='Phase0'>
      <consume channel='beta' tokens='6'/>
      <consume channel='d3' tokens='1'/>
      <produce channel='d3' tokens='1'/>
      <profile execution_time='2'/>
    </subscenario>
    <subscenario name='Phase1'>
      <consume channel='beta' tokens='6'/>
      <consume channel='d3' tokens='1'/>
      <produce channel='d3' tokens='1'/>
      <profile execution_time='3'/>
    </subscenario>
    <markov_chain initial_state='Phase1'>
      <state name='Phase0' subscenario='Phase0'>
        <transition destination='Phase1' weight='1'/>
      </state>
      <state name='Phase1' subscenario='Phase1'>
        <transition destination='Phase0' weight='1'/>
      </state>
    </markov_chain>
  </detector_properties>

  <channel_properties channel='d1' number_of_initial_tokens='1'/>
  <channel_properties channel='d2' number_of_initial_tokens='1'/>
  <channel_properties channel='d3' number_of_initial_tokens='1'/>
</properties>

</sadf>
</sdf3>
