<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SADF: convert SDF to SADF on h263decode</name>
		<program>sdf3convert-sadf-sdf2sadf --graph h263decoder.xml --output sdf-to-sadf.xml</program>
		<type>xmlcompare</type>
		<programOutput>sdf-to-sadf.xml</programOutput>
	</settings>

</sdf3>
