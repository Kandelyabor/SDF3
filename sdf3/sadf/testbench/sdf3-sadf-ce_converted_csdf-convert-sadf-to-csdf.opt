<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SADF: convert SADF to CSDF on ce_converted_sadf</name>
		<program>sdf3convert-sadf-sadf2csdf --graph ce_converted_csdf.xml --output sadf-to-csdf.xml</program>
		<type>xmlcompare</type>
		<programOutput>sadf-to-csdf.xml</programOutput>
	</settings>

</sdf3>
