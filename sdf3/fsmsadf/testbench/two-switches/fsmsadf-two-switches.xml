<?xml version="1.0"?>
<sdf3 type="fsmsadf">
  <applicationGraph name="two_switches" type="fsmsadf">
    <fsmsadf>
      <scenariograph name="scenario1" type="scenariograph">
        <actor name="a" type="a">
          <port name="fab9_0" rate="2" type="out"/>
          <port name="fab10_1" rate="3" type="out"/>
        </actor>
        <actor name="c" type="c">
          <port name="fbc11_0" rate="2" type="in"/>
        </actor>
        <actor name="b" type="b">
          <port name="fbc11_0" rate="2" type="out"/>
          <port name="fab9_0" rate="2" type="in"/>
          <port name="fab10_1" rate="3" type="in"/>
        </actor>
        <channel dstActor="b" dstPort="fab9_0" name="fab9" srcActor="a" srcPort="fab9_0"/>
        <channel dstActor="b" dstPort="fab10_1" name="fab10" srcActor="a" srcPort="fab10_1"/>
        <channel dstActor="c" dstPort="fbc11_0" name="fbc11" srcActor="b" srcPort="fbc11_0"/>
      </scenariograph>
    </fsmsadf>
    <fsmsadfProperties>
      <graphProperties>
        <timeConstraints>
          <throughput>2e-10</throughput>
        </timeConstraints>
      </graphProperties>
      <units>
        <timeUnit>20 ns</timeUnit>
        <dataUnit>1 B</dataUnit>
      </units>
      <scenarios>
        <scenario graph="scenario1" name="scenario1" reward="1">
          <actorProperties actor="a">
            <processor default="true" type="microblaze">
              <implementation>
                <function symbol="a_func"/>
              </implementation>
              <executionTime time="10000"/>
              <memory name=".code" size="4000" type="instr"/>
              <memory name=".data" size="4000" type="data"/>
            </processor>
          </actorProperties>
          <actorProperties actor="c">
            <processor default="true" type="microblaze">
              <implementation>
                <function symbol="c_func"/>
              </implementation>
              <executionTime time="10000"/>
              <memory name=".code" size="4000" type="instr"/>
              <memory name=".data" size="4000" type="data"/>
            </processor>
          </actorProperties>
          <actorProperties actor="b">
            <processor default="true" type="microblaze">
              <implementation>
                <function symbol="b_func"/>
              </implementation>
              <executionTime time="10000"/>
              <memory name=".code" size="4000" type="instr"/>
              <memory name=".data" size="4000" type="data"/>
            </processor>
          </actorProperties>
          <channelProperties channel="fab9">
            <tokenSize sz="4"/>
          </channelProperties>
          <channelProperties channel="fab10">
            <tokenSize sz="4"/>
          </channelProperties>
          <channelProperties channel="fbc11">
            <tokenSize sz="4"/>
          </channelProperties>
        </scenario>
      </scenarios>
    </fsmsadfProperties>
    <fsm detector="a" initialstate="q1">
      <state name="q1" scenario="scenario1">
        <transition destination="q1"/>
      </state>
    </fsm>
  </applicationGraph>
</sdf3>
