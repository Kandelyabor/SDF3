<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>FSM-SADF transform: wc_sdfg on mp3 decoder</name>
		<program>sdf3transform-fsmsadf --transform wc_sdfg --graph mp3decoder.xml --output mp3decoder_wc.xml</program>
		<type>outputcompare</type>
		<programOutput>mp3decoder_wc.xml</programOutput>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
