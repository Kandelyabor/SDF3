// srcRate the rate on the source port
// dstRate the rate on the destination port
// tokenSize the size of the token in words 
// initialToken the number of initial tokens.

dftype = fsmsadf
name = merge_test
digraph scenario1 {
  d->e [srcRate=2 dstRate=2]
  e->e [initialTokens=t3 channelName=ee]
  b->d [srcRate=4 dstRate=4]
  c->e [srcRate=2 dstRate=4]
  b->c [srcRate=4 dstRate=2] 
  b->b [initialTokens=t4]
  a->b [srcRate=3 dstRate=3 channelName=out1]
  a->a [initialTokens=t1 channelName=aa1]
}

digraph scenario2 {
  g->e [srcRate=2 dstRate=4]
  e->e [initialTokens=t3 channelName=ee]
  f->g [srcRate=4 dstRate=2]
  c->e [srcRate=2 dstRate=4]
  f->c [srcRate=4 dstRate=2] 
  f->f [initialTokens=t4]
  a->f [srcRate=3 dstRate=3 channelName=out1]
  a->a [initialTokens=t1 channelName=aa1]
}

fsm [initial=scenario1 detector=a] {
  scenario1 -> scenario1
  scenario1 -> scenario2
  scenario2 -> scenario1
  scenario2 -> scenario2
}

timeUnit = 20 ns
dataUnit = 1 B
throughput=1e-10
