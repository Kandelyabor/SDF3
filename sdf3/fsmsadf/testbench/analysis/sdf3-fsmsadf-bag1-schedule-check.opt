<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>FSM-SADF analyze: check schedule in binding aware graph on bag-1</name>
		<program>sdf3analyze-fsmsadf --algo schedule-check --graph bag-1.xml --seq scenario1,scenario2,scenario2,scenario1</program>
		<type>outputcompare</type>
		<reference>The schedule check passed.
analysis time: 0ms</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
