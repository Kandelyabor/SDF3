<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>FSM-SADF analyze: throughput-mpautomaton-weakconsistency on mp3decoder_vld_r10_s5</name>
		<program>sdf3analyze-fsmsadf --algo throughput-mpautomaton --graph mp3decoder_vld_r10_s5.xml</program>
		<type>outputcompare</type>
		<programOutput></programOutput>
		<reference>Throughput (max-plus automaton):          1.72831e-07</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
