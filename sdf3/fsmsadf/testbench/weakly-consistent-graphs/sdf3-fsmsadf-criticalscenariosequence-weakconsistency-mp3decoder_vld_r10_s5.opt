<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>FSM-SADF analyze: criticalscenariosequence on mp3decoder_vld_r10_s5</name>
		<program>sdf3analyze-fsmsadf --algo criticalscenariosequence --graph mp3decoder_vld_r10_s5.xml</program>
		<type>outputcompare</type>
		<programOutput></programOutput>
		<reference>Critical scenario sequence:
vld_dec, vld_dec, sl, vld_dec, vld_dec, vld_dec, sl, vld_dec, sl, vld_dec, vld_dec, vld_dec, file_reading, vld_dec, sl</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
