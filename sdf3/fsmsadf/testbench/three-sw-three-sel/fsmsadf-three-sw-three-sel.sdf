// srcRate the rate on the source port
// dstRate the rate on the destination port
// tokenSize the size of the token in words
// initialToken the number of initial tokens

name=three_sw_three_sel
dftype = fsmsadf
digraph scenario1 {
    a->b [srcRate=2 dstRate=2 channelName=outOne]
    a->b [srcRate=3 dstRate=3 channelName=outTwo]
    a->b [srcRate=4 dstRate=4 channelName=outThree]
    a->a [channelName=aself initialTokens=atoken]
    b->c [srcRate=2 dstRate=2]
    b->c [srcRate=3 dstRate=3]
    b->c [srcRate=4 dstRate=4]
    c->a [srcRate=2 dstRate=2 channelName=inOne initialTokens=t1,t2]
    c->a [srcRate=3 dstRate=3 channelName=inTwo initialTokens=t3,t4,t5]
    c->a [srcRate=4 dstRate=4 channelName=inThree initialTokens=t6,t7,t8,t9]
}

digraph scenario2 {
    a->d [srcRate=2 dstRate=2 channelName=outOne]
    a->d [srcRate=3 dstRate=3 channelName=outTwo]
    a->d [srcRate=4 dstRate=4 channelName=outThree]
    a->a [channelName=aself initialTokens=atoken]
    d->a [srcRate=2 dstRate=2 channelName=inOne initialTokens=t1,t2]
    d->a [srcRate=3 dstRate=3 channelName=inTwo initialTokens=t3,t4,t5]
    d->a [srcRate=4 dstRate=4 channelName=inThree initialTokens=t6,t7,t8,t9]
}

digraph scenario3 {
    a->e [srcRate=2 dstRate=2 channelName=outOne]
    a->e [srcRate=3 dstRate=3 channelName=outTwo]
    a->e [srcRate=4 dstRate=4 channelName=outThree]
    a->a [channelName=aself initialTokens=atoken]
    e->f [srcRate=9 dstRate=9]
    f->a [srcRate=2 dstRate=2 channelName=inOne initialTokens=t1,t2]
    f->a [srcRate=3 dstRate=3 channelName=inTwo initialTokens=t3,t4,t5]
    f->a [srcRate=4 dstRate=4 channelName=inThree initialTokens=t6,t7,t8,t9]
}


fsm [initial=scenario1 detector=a] {
  scenario1 -> scenario1
  scenario1 -> scenario2
  scenario1 -> scenario3
  scenario2 -> scenario1
  scenario2 -> scenario2
  scenario2 -> scenario3
  scenario3 -> scenario1
  scenario3 -> scenario2
  scenario3 -> scenario3
}

timeUnit = 20 ns
dataUnit = 1 B
throughput=2e-10

