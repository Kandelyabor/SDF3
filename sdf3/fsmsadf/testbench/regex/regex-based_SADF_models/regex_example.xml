<?xml version="1.0"?>
<sdf3 type="fsmsadf">
  <applicationGraph name="regextest" type="fsmsadf">
    <fsmsadf>
      <scenariograph name="graphstructure" type="scenariograph">
        <actor name="P" type="actor">
          <port name="selfout" rate="1" type="out"/>
          <port name="selfin" rate="1" type="in"/>
          <port name="PQ" rate="1" type="out"/>
        </actor>
        <actor name="Q" type="actor">
          <port name="PQ" rate="1" type="in"/>
          <port name="RQ" rate="1" type="in"/>
          <port name="QR" rate="1" type="out"/>
        </actor>
        <actor name="R" type="output">
          <port name="QR" rate="1" type="in"/>
          <port name="RQ" rate="1" type="out"/>
		  <port name="selfout" rate="1" type="out"/>
          <port name="selfin" rate="1" type="in"/>
        </actor>
        <channel dstActor="P" dstPort="selfin" name="selfP" srcActor="P" srcPort="selfout" initialTokens="1" persistentTokenNames="w"/>
        <channel dstActor="Q" dstPort="PQ" name="P2Q" srcActor="P" srcPort="PQ" initialTokens="0"/>
        <channel dstActor="R" dstPort="QR" name="Q2R" srcActor="Q" srcPort="QR" initialTokens="1" persistentTokenNames="x"/>
        <channel dstActor="Q" dstPort="RQ" name="R2Q" srcActor="R" srcPort="RQ" initialTokens="1" persistentTokenNames="y"/>
		<channel dstActor="R" dstPort="selfin" name="selfR" srcActor="R" srcPort="selfout" initialTokens="1" persistentTokenNames="z"/>
      </scenariograph>
      <scenariograph name="graphstructure1" type="scenariograph">
        <actor name="P" type="actor">
          <port name="selfout" rate="1" type="out"/>
          <port name="selfin" rate="1" type="in"/>
