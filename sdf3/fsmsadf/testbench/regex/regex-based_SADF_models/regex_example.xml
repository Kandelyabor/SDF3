        <channel dstActor="Q" dstPort="PQ" name="P2Q" srcActor="P" srcPort="PQ" initialTokens="1" finalTokens="0" persistentTokenNames="t"/>
        <channel dstActor="R" dstPort="QR" name="Q2R" srcActor="Q" srcPort="QR" initialTokens="1" persistentTokenNames="y"/>
