        </actor>
        <actor name="R" type="output">
          <port name="QR" rate="1" type="in"/>
          <port name="RQ" rate="1" type="out"/>
        </actor>
        <channel dstActor="P" dstPort="selfin" name="selfP" srcActor="P" srcPort="selfout" initialTokens="1" persistentTokenNames="x"/>
        <channel dstActor="Q" dstPort="PQ" name="P2Q" srcActor="P" srcPort="PQ" initialTokens="0" finalTokens="1" persistentFinalTokenNames = "t"/>
        <channel dstActor="R" dstPort="QR" name="Q2R" srcActor="Q" srcPort="QR" initialTokens="1" persistentTokenNames="y"/>
        <channel dstActor="Q" dstPort="RQ" name="R2Q" srcActor="R" srcPort="RQ" initialTokens="1" persistentTokenNames="z"/>
      </scenariograph>
            <scenariograph name="graphstructure2" type="scenariograph">
