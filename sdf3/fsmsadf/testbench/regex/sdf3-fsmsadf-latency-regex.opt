<?xml version="1.0" encoding="UTF-8"?>
<sdf3 type="fsmsadf" version="1.0">

	<settings type="test">
		<name>FSMSADF analyze: latency-regex on regexExample</name>
		<program>sdf3analyze-fsmsadf --graph regexExample.xml --algo latency-regex --period 4.0</program>
		<type>outputcompare</type>
		<programOutput></programOutput>
		<reference>The latency vector is : 4 4 1 4 with respect to initial tokens w  x  y  z  </reference>
		<ignore>analysis time: .*$</ignore>
	</settings>
      
</sdf3>
