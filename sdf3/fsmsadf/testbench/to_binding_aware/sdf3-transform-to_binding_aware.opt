<?xml version="1.0" encoding="UTF-8"?>
<sdf3 type="fsmsadf" version="1.0">

    <settings type="test">
        <name>sdf3transform-fsmsadf to_binding_aware</name>
        <program>./run_test.sh --settings sdf3-transform-to_binding_aware.opt</program>
        <type>xmlcompare</type>
        <programOutput>fsmsadf-flow-test-mapped.xml</programOutput>
        <programOutput>bag-6.xml</programOutput>
        <programOutput>fsmsadf-to_binding_aware.xml</programOutput>
    </settings>

  <settings type="generate" random="no">
	<input file="fsmsadf-flow-test.sdf"/>
  </settings>

  <settings type="flow">
    <platformType type="CompSoC"/>
    <flowType type="NSoC"/> <!--supported types: NSoC -->
    <maxNrBindingsTileBindingAlgo n="5"/>
    <!-- maximum number of platform bindings outputted by tile binding  and
         scheduling algorithm. -->
    <applicationGraph file="fsmsadf-flow-test.xml"/>
    <!-- application graphs are mapped in the order in which they appear in
         this file. -->
    <architectureGraph file="architecture.xml"/>
    <!-- SDF3 creates an SDF3 document from an applicationGraph and the
         architectureGraph. It uses the applicationGraph and mapping nodes
         from the applicationGraph file and it uses the architectureGraph node
         from the architecture graph. -->
	<output file="fsmsadf-flow-test-mapped.xml"/>
	<chanToConnModelFile>compsoc-chantoconn.xml</chanToConnModelFile>
  </settings>

  <settings type="transform">
	<graph file="fsmsadf-flow-test-mapped.xml"/>
    <transform>
        <type name="to_binding_aware"/>
    </transform>
    <output file="fsmsadf-to_binding_aware.xml"/>
  </settings>

</sdf3>
