<?xml version="1.0" encoding="UTF-8"?>
<sdf3 type="fsmsadf" version="1.0">

	<settings type="test">
		<name>sdf3analyze-fsmsadf trace</name>
		<program>sdf3analyze-fsmsadf --settings sdf3-analyze-trace.opt</program>
		<type>outputcompare</type>
		<programOutput>fsmsadf-analyze-test-trace.txt</programOutput>
		<programOutput>fsmsadf-analyze-test-trace.etf</programOutput>
	</settings>

  <settings type="analyze">
	<graph file="fsmsadf-analyze-test.xml"/>
    <algo name="trace"/>
    <seq>
        <entry name="scenario1"/>
        <entry name="scenario2"/>
        <entry name="scenario2"/>
        <entry name="scenario1"/>
        <entry name="scenario1"/>
    </seq>
    <traceTxt file="fsmsadf-analyze-test-trace.txt"/>
    <traceEtf file="fsmsadf-analyze-test-trace.etf"/>
  </settings>

</sdf3>
