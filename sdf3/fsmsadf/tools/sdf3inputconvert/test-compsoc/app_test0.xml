<?xml version='1.0' encoding='UTF-8'?>
<nest type='csdf' xmlns:xsi='https://www.w3.org/2001/XMLSchema-instance'
    xmlns='uri:nest' version='1.0'
    xsi:schemaLocation='uri:nest https://www.es.ele.tue.nl/nest/xsd/csdf.xsd'>
    <applicationGraph name='example-app'>
    <!-- This example shows a simple application modelled with a CSDF graph.
         The graph consists of three actors connected through three channels.
         One of these channels contains four initial tokens.
    -->
    <csdfgraph name='example-app'>
        <!-- The 'csdfgraph' element contains the structure of the
             graph. The graph consists of a set of actors connected via
             channels.
        -->
        <actor name='a' size='4'>
         <!-- A sequence of rates must be specified on each port. This
              sequence is given as a comma separated list of values. As
              a short-hand notation, it is allowed to use an 'x' operator
              to indicate that the value is repeated for a specified
              number of times in the sequence. E.g. the rate '2x2,2x0' is
              equivalent to the rate '2,2,0,0'. The length of the
              rate sequence must be equal for all ports on an actor.
              The length of the rate sequences on different actors may
              however be different.
         -->
            <port name='in0' type='in' rate='2,2,1,1'/>
            <port name='out0' type='out' rate='1,1,1,1'/>


        <!-- The 'executionTime' element provides the execution time of an
             actor in term of an abstract time unit. This value does not relate
             to a specific processor type or wall clock time. The element is
             optional. It will be useful for researchers that work on dataflow
             analysis technique, but it will most likely not be used by
             researcher working on a mapping flow. The length of the sequence
             must be equal to the length of the rate sequences. The format for
             denoting it is also equal to the format used for the rate
             sequences.
        -->
            <executionTime time='100,100,50,50'/>
        </actor>
        <actor name='b' size='1'>
            <port name='in0' type='in' rate='1'/>
            <port name='out0' type='out' rate='1'/>

            <executionTime time='10'/>
        </actor>
        <actor name='c' size='4'>
            <port name='in0' type='in' rate='1,1,1,1'/>
            <port name='out0' type='out' rate='2,2,1,1'/>

            <executionTime time='13,0,11,11'/>
        </actor>
        <!-- The number of initial tokens on a channel is an optional
             argument. When it is not specified, it is assumed that the
             channel contains no initial tokens.
        -->

        <channel name='a2b' srcActor='a' srcPort='out0'
                            dstActor='b' dstPort='in0'/>
        <channel name='b2c' srcActor='b' srcPort='out0'
                            dstActor='c' dstPort='in0'/>
        <channel name='c2a' srcActor='c' srcPort='out0'
                            dstActor='a' dstPort='in0' initialTokens='4'/>

    </csdfgraph>
    <csdfProperties>
        <!-- The 'csdfProperties' element specifies the resource requirements
             and implementation details of all actors and channels in the graph.
             The resource requirements of the actors and channels are specified
             using abstract time and data units. A separate 'units' element is
             provides a relation between these abstract units and the
             real-world.
        -->
        <units>
            <!-- Relation between the abstract time unit used in the
                 application graph and the real-world. This relation consists
                 of a value followed by one of the following units:

                 cc - clock cycle
                 us - micro second
                 ns - nano second
            -->
            <timeUnit>1 ns</timeUnit>
            <!-- Relation between the abstract data unit used in the
                 application graph and the real-world.This relation consists
                 of a value followed by one of the following units:

                 b  - bit
                 B  - Byte
                 kb - 1024 bit
                 kB - 1024 byte
                 Mb - 1024*1024 bit
                 MB - 1024*1024 byte
            -->
            <dataUnit> 1 kb </dataUnit>
        </units>
        <actorProperties actor='a'>
            <!-- The 'actorProperties' element specifies the resource
                 requirements of an actor. This element may contain multiple
                 'processor' elements. Each processor element specifies the
                 resource requirements for a specific processor type. -->
            <processor type='microblaze' default='true'>
                <!-- The 'defaultProperties' element specifies the resource
                     requirements of an actor during a firing. These resources
                     are assumed to be needed during each phase. When an actor
                     has different resource requirements during a specific
                     period, then it is possible to overwrite the default
                     values using the 'phaseProperties' element that is shown
                     below.
                -->
                <defaultProperties>
                    <!-- worst-case execution time in clock cycles -->
                    <executionTime cycles='1000'/>
                    <memory>
                        <!-- A memory element specifies a block of memory that
                             is required to implement an actor. This
                             information is needed in the mapping flow to
                             allocate sufficient memory for an actor. There is
                             no limit on the number of memory elements that can
                             be specified. A mapping flow must map all memory
                             elements that are specified in this section to the
                             various memories in the platform. Hence, there is
                             no option to specify various sets of memory
                             elements that provide a trade-off in some quantity.
                        -->
                        <memoryElement name='.code'>
                            <!-- Size of the memory element in data units. -->
                            <size>1000</size>
                            <!-- Access type required on the memory element.
                                 The following types are allowed: IFetch,
                                 DRead, DWrite. Multiple access types may be
                                 specified through a comma separated list. -->
                            <accessType>IFetch</accessType>
                            <!-- Minimal required size of a memory operation
                                 on this memory element. The following sizes
                                 are allowed: byte, halfword, word. -->
                            <accessSize>word</accessSize>
                        </memoryElement>
                        <memoryElement name='.data'>
                            <size>1000</size>
                            <accessType>DRead,DWrite</accessType>
                            <accessSize>halfword</accessSize>
                        </memoryElement>
                        <memoryElement name='sharedVar'>
                            <size>1000</size>
                            <accessType>DRead,DWrite</accessType>
                            <accessSize>byte</accessSize>
                        </memoryElement>
                    </memory>
                    <implementation>
                        <!-- The 'implementation' element provides the links
                             between the model and the application source code.
                        -->
                        <function symbol='func_a'>
                            <!-- The 'function' element specifies the 'symbol'
                                 (i.e. function name) that implements the
                                 actor functionality. -->
                            <argumentMapping>
                                <!-- The 'argumentMapping element specifies a
                                     mapping of each port on the actor to an
                                     argument on the function call. The
                                     arguments on the function call are
                                     numbered starting from 0. The function does
                                     not return any value (i.e. its return type
                                     is a void). A variable that needs to be
                                     written to an output port must be passed
                                     by reference into the function. When a port
                                     has a rate larger than one, a pointer to an
                                     array is passed to the function. The size
                                     of the array is equal to the rate of the
                                     port. -->
                                <argument number='0' port='in0'/>
                                <argument number='1' port='out0'/>
                            </argumentMapping>
                        </function>
                        <sourceFiles>
                            <!-- The 'sourceFiles' element contains a list of
                                 'file' elements that specify all source files
                                 that need to be compiled in order to implement
                                 this actor. It is allowed to specify multiple
                                 files inside the 'sourceFiles' element. It is
                                 also allowed to specify the same file inside
                                 the 'sourceFiles' element of different actors.
                            -->
                            <file name='a.c'/>
                            <file name='a_support.c'/>
                        </sourceFiles>
                    </implementation>
                </defaultProperties>
                <phaseProperties fromPhase='1' toPhase='3'>
                    <!-- Any of the default properties can be overwritten
                         inside the phaseProperties element. The attributes
                         'fromPhase' and 'toPhase' indicate the range of phases
                         to which the specified properties applies. The property
                         applies starting in the phase number indicated by the
                         'fromPhase' attribute and it remains valid up-to and
                         including the phase number indicated by the 'toPhase'
                         attribute. First phase in the sequence has number
                         zero (0).
                    -->
                    <executionTime cycles='0'/>
                </phaseProperties>
            </processor>
        </actorProperties>
        <actorProperties actor='b'>
            <processor type='microblaze' default='true'>
                <defaultProperties>
                    <executionTime cycles='1000'/>
                    <memory>
                        <memoryElement name='.code'>
                            <size>1000</size>
                            <accessType>IFetch</accessType>
                            <accessSize>word</accessSize>
                        </memoryElement>
                        <memoryElement name='.data'>
                            <size>1000</size>
                            <accessType>DRead,DWrite</accessType>
                            <accessSize>halfword</accessSize>
                        </memoryElement>
                    </memory>
                    <implementation>
                        <function symbol='func_b'>
                            <argumentMapping>
                                <argument number='0' port='in0'/>
                                <argument number='1' port='out0'/>
                            </argumentMapping>
                        </function>
                        <sourceFiles>
                            <file name='b.c'/>
                        </sourceFiles>
                    </implementation>
                </defaultProperties>
            </processor>
        </actorProperties>
        <actorProperties actor='c'>
            <processor type='microblaze' default='true'>
                <defaultProperties>
                    <executionTime cycles='1000'/>
                    <memory>
                        <memoryElement name='.code'>
                            <size>1000</size>
                            <accessType>IFetch</accessType>
                            <accessSize>word</accessSize>
                        </memoryElement>
                        <memoryElement name='.data'>
                            <size>1000</size>
                            <accessType>DRead,DWrite</accessType>
                            <accessSize>halfword</accessSize>
                        </memoryElement>
                    </memory>
                    <implementation>
                        <function symbol='func_c'>
                            <argumentMapping>
                                <argument number='0' port='in0'/>
                                <argument number='1' port='out0'/>
                            </argumentMapping>
                        </function>
                        <sourceFiles>
                            <file name='c.c'/>
                        </sourceFiles>
                    </implementation>
                </defaultProperties>
            </processor>
        </actorProperties>
        <channelProperties channel='a2b'>
            <!-- The 'channelProperties' element specifies the resource
                 requirements of a channel. -->
            <!-- The size of a single token in data units. -->
            <tokenSize size='10'/>
        </channelProperties>
        <channelProperties channel='b2c'>
          <tokenSize size='1'/>
        </channelProperties>
        <channelProperties channel='a2c'>
          <tokenSize size='1'/>
        </channelProperties>
      <channelProperties channel='c2a'>
          <tokenSize size='1'/>
        </channelProperties>

        <graphProperties>
            <!-- The 'graphProperties' element specifies the timing constraints
                 of the application graph. -->
            <timeConstraints>
                <!-- Throughput constraint in iterations / time-unit. The
                     throughput constraint uses the standard notion of an
                     iteration as it is defined for CSDF graphs. For most
                     practical CSDF models there is a natural relation between
                     the concept of an iteration and the amount of output that
                     is produced by the graph. (E.g. a typical CSDF model of a
                     video decoder produces one frame per iteration.)  -->
                <throughput>0.000000001</throughput>
                <!-- Latency constraint between a source and destination actor
                     in time-units -->
                <latency srcActor='a' dstActor='b'>5000</latency>
            </timeConstraints>
        </graphProperties>
    </csdfProperties>
    </applicationGraph>
    <useCases>
        <!-- The 'useCases' element can be used to specify which combinations
             of applications can be active simultaniously.

             Note: the details of this section are not complete yet. We intend
             to follow the approach that Andreas used in which he defines
             through some regular expressions which applications are allowed to
             be executed in parallel with a specific application. Below you can
             find some example constraints. The format will be specified in a
             later stage.
        -->
        <constraint type='allow' appl='example-app'
                    with='(player|game)'/>
        <constraint type='allow' appl='player'
                    with='.*'/>
        <constraint type='allow' appl='game'
                    with='(example-app\|player)'/>
    </useCases>
</nest>

