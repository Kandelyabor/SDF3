<?xml version="1.0"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xmlns="uri:sdf3" version="1.0" type="fsmsadf" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">
  <applicationGraph name="example-app">
    <fsmsadf>
      <scenariograph name="example-s1-s1" type="EXAMPLE-S1">
        <actor name="a" type="A">
          <port name="in" type="in" rate="1"/>
          <port name="out" type="out" rate="1"/>
        </actor>
        <actor name="b" type="B">
          <port name="in" type="in" rate="1"/>
          <port name="out" type="out" rate="1"/>
        </actor>
        <actor name="c" type="C">
          <port name="in" type="in" rate="1"/>
          <port name="out" type="out" rate="1"/>
        </actor>
        <channel name="a2b" srcActor="a" srcPort="out" dstActor="b" dstPort="in" initialTokens="0"/>
        <channel name="b2c" srcActor="b" srcPort="out" dstActor="c" dstPort="in" initialTokens="0"/>
        <channel name="c2a" srcActor="c" srcPort="out" dstActor="a" dstPort="in" initialTokens="2"/>
      </scenariograph>
      <scenariograph name="example-s2-s2" type="EXAMPLE-S2">
        <actor name="a" type="A">
          <port name="in1" type="in" rate="1"/>
          <port name="in2" type="in" rate="1"/>
          <port name="out" type="out" rate="1"/>
        </actor>
        <actor name="b" type="B">
          <port name="in" type="in" rate="1"/>
          <port name="out1" type="out" rate="1"/>
          <port name="out2" type="out" rate="1"/>
        </actor>
        <actor name="c" type="C">
          <port name="in" type="in" rate="1"/>
          <port name="out" type="out" rate="1"/>
        </actor>
        <actor name="d" type="D">
          <port name="in" type="in" rate="1"/>
          <port name="out" type="out" rate="1"/>
        </actor>
        <channel name="a2b" srcActor="a" srcPort="out" dstActor="b" dstPort="in" initialTokens="0"/>
        <channel name="b2c" srcActor="b" srcPort="out1" dstActor="c" dstPort="in" initialTokens="0"/>
        <channel name="b2d" srcActor="b" srcPort="out2" dstActor="d" dstPort="in" initialTokens="0"/>
        <channel name="c2a" srcActor="c" srcPort="out" dstActor="a" dstPort="in1" initialTokens="2"/>
        <channel name="d2a" srcActor="d" srcPort="out" dstActor="a" dstPort="in2" initialTokens="1"/>
      </scenariograph>
      <scenariograph name="example-s2-s3" type="EXAMPLE-S2">
        <actor name="a" type="A">
          <port name="in1" type="in" rate="1"/>
          <port name="in2" type="in" rate="1"/>
          <port name="out" type="out" rate="1"/>
        </actor>
        <actor name="b" type="B">
          <port name="in" type="in" rate="1"/>
          <port name="out1" type="out" rate="1"/>
          <port name="out2" type="out" rate="1"/>
        </actor>
        <actor name="c" type="C">
          <port name="in" type="in" rate="2"/>
          <port name="out" type="out" rate="2"/>
        </actor>
        <actor name="d" type="D">
          <port name="in" type="in" rate="1"/>
          <port name="out" type="out" rate="1"/>
        </actor>
        <channel name="a2b" srcActor="a" srcPort="out" dstActor="b" dstPort="in" initialTokens="0"/>
        <channel name="b2c" srcActor="b" srcPort="out1" dstActor="c" dstPort="in" initialTokens="0"/>
        <channel name="b2d" srcActor="b" srcPort="out2" dstActor="d" dstPort="in" initialTokens="0"/>
        <channel name="c2a" srcActor="c" srcPort="out" dstActor="a" dstPort="in1" initialTokens="2"/>
        <channel name="d2a" srcActor="d" srcPort="out" dstActor="a" dstPort="in2" initialTokens="1"/>
      </scenariograph>
    </fsmsadf>
    <fsmsadfProperties>
      <defaultProperties>
        <actorProperties actor="a">
          <port name="in" rate="1"/>
          <port name="out" rate="1"/>
        </actorProperties>
        <actorProperties actor="b">
          <port name="in" rate="1"/>
          <port name="out" rate="1"/>
        </actorProperties>
        <actorProperties actor="c">
          <port name="in" rate="1"/>
          <port name="out" rate="1"/>
        </actorProperties>
        <actorProperties actor="d">
          <port name="in" rate="1"/>
          <port name="out" rate="1"/>
        </actorProperties>
        <channelProperties channel="a2b"/>
        <channelProperties channel="b2c"/>
        <channelProperties channel="c2a"/>
        <channelProperties channel="b2d"/>
        <channelProperties channel="d2a"/>
      </defaultProperties>
      <scenarios>
        <scenario name="s1" graph="example-s1-s1">
          <actorProperties actor="a">
            <processor type="arm7" default="true">
              <executionTime time="1000"/>
              <memory name="am" size="100" type="shared"/>
            </processor>
          </actorProperties>
          <actorProperties actor="b">
            <processor type="arm7" default="true">
              <executionTime time="1000"/>
              <memory name="bm" size="100" type="shared"/>
            </processor>
          </actorProperties>
          <actorProperties actor="c">
            <processor type="arm7" default="true">
              <executionTime time="1000"/>
              <memory name="cm" size="100" type="shared"/>
            </processor>
          </actorProperties>
          <channelProperties channel="a2b">
            <tokenSize sz="10"/>
          </channelProperties>
          <channelProperties channel="b2c">
            <tokenSize sz="1"/>
          </channelProperties>
          <channelProperties channel="c2a">
            <tokenSize sz="1"/>
          </channelProperties>
          <storageDistributions>
            <storageDistribution sz="0" thr="0">
              <channel name="a2b" sz="0"/>
              <channel name="b2c" sz="0"/>
              <channel name="c2a" sz="0"/>
            </storageDistribution>
            <storageDistribution sz="4" thr="0.0005">
              <channel name="a2b" sz="1"/>
              <channel name="b2c" sz="1"/>
              <channel name="c2a" sz="2"/>
            </storageDistribution>
            <storageDistribution sz="6" thr="0.000666667">
              <channel name="a2b" sz="2"/>
              <channel name="b2c" sz="2"/>
              <channel name="c2a" sz="2"/>
            </storageDistribution>
          </storageDistributions>
        </scenario>
        <scenario name="s2" graph="example-s2-s2">
          <actorProperties actor="a">
            <processor type="arm7" default="true">
              <executionTime time="1000"/>
              <memory name="am" size="100" type="shared"/>
            </processor>
          </actorProperties>
          <actorProperties actor="b">
            <processor type="arm7" default="true">
              <executionTime time="1000"/>
              <memory name="bm" size="100" type="shared"/>
            </processor>
          </actorProperties>
          <actorProperties actor="c">
            <processor type="arm7" default="true">
              <executionTime time="1000"/>
              <memory name="cm" size="100" type="shared"/>
            </processor>
          </actorProperties>
          <actorProperties actor="d">
            <processor type="arm7" default="true">
              <executionTime time="1000"/>
              <memory name="dm" size="100" type="shared"/>
            </processor>
          </actorProperties>
          <channelProperties channel="a2b">
            <tokenSize sz="10"/>
          </channelProperties>
          <channelProperties channel="b2c">
            <tokenSize sz="1"/>
          </channelProperties>
          <channelProperties channel="b2d">
            <tokenSize sz="1"/>
          </channelProperties>
          <channelProperties channel="c2a">
            <tokenSize sz="1"/>
          </channelProperties>
          <channelProperties channel="d2a">
            <tokenSize sz="1"/>
          </channelProperties>
          <storageDistributions>
            <storageDistribution sz="0" thr="0">
              <channel name="a2b" sz="0"/>
              <channel name="b2c" sz="0"/>
              <channel name="b2d" sz="0"/>
              <channel name="c2a" sz="0"/>
              <channel name="d2a" sz="0"/>
            </storageDistribution>
            <storageDistribution sz="6" thr="0.000333333">
              <channel name="a2b" sz="1"/>
              <channel name="b2c" sz="1"/>
              <channel name="b2d" sz="1"/>
              <channel name="c2a" sz="2"/>
              <channel name="d2a" sz="1"/>
            </storageDistribution>
          </storageDistributions>
        </scenario>
        <scenario name="s3" graph="example-s2-s3">
          <actorProperties actor="a">
            <processor type="arm7" default="true">
              <executionTime time="1000"/>
              <memory name="am" size="100" type="shared"/>
            </processor>
          </actorProperties>
          <actorProperties actor="b">
            <processor type="arm7" default="true">
              <executionTime time="1000"/>
              <memory name="bm" size="100" type="shared"/>
            </processor>
          </actorProperties>
          <actorProperties actor="c">
            <processor type="arm7" default="true">
              <executionTime time="1000"/>
              <memory name="cm" size="100" type="shared"/>
            </processor>
          </actorProperties>
          <actorProperties actor="d">
            <processor type="arm7" default="true">
              <executionTime time="1000"/>
              <memory name="dm" size="100" type="shared"/>
            </processor>
          </actorProperties>
          <channelProperties channel="a2b">
            <tokenSize sz="10"/>
          </channelProperties>
          <channelProperties channel="b2c">
            <tokenSize sz="1"/>
          </channelProperties>
          <channelProperties channel="b2d">
            <tokenSize sz="1"/>
          </channelProperties>
          <channelProperties channel="c2a">
            <tokenSize sz="1"/>
          </channelProperties>
          <channelProperties channel="d2a">
            <tokenSize sz="1"/>
          </channelProperties>
          <storageDistributions>
            <storageDistribution sz="0" thr="0">
              <channel name="a2b" sz="0"/>
              <channel name="b2c" sz="0"/>
              <channel name="b2d" sz="0"/>
              <channel name="c2a" sz="0"/>
              <channel name="d2a" sz="0"/>
            </storageDistribution>
            <storageDistribution sz="7" thr="0.000166667">
              <channel name="a2b" sz="1"/>
              <channel name="b2c" sz="2"/>
              <channel name="b2d" sz="1"/>
              <channel name="c2a" sz="2"/>
              <channel name="d2a" sz="1"/>
            </storageDistribution>
          </storageDistributions>
        </scenario>
      </scenarios>
      <graphProperties>
        <timeConstraints>
          <throughput>1.0000000000e-10</throughput>
        </timeConstraints>
      </graphProperties>
    </fsmsadfProperties>
    <fsm initialstate="q1">
      <state name="q1" scenario="s1">
        <transition destination="q2"/>
        <transition destination="q3"/>
      </state>
      <state name="q2" scenario="s2">
        <transition destination="q1"/>
      </state>
      <state name="q3" scenario="s3">
        <transition destination="q1"/>
      </state>
    </fsm>
  </applicationGraph>
  <architectureGraph name="example-arch">
    <tile name="t1">
      <processor name="proc" type="arm7">
        <arbitration type="TDMA" wheelsize="100" contextSwitchOverhead="15" preemptive="true"/>
      </processor>
      <memory name="memt1" size="100" type="shared"/>
      <memory name="memt2" size="400" type="shared"/>
      <networkInterface name="ni" nrInConnections="10" nrOutConnections="10" inBandwidth="12" outBandwidth="12"/>
    </tile>
    <tile name="t2">
      <processor name="proc" type="powerpc">
        <arbitration type="TDMA" wheelsize="100" contextSwitchOverhead="15" preemptive="true"/>
      </processor>
      <memory name="memt2" size="5600" type="shared"/>
      <networkInterface name="ni" nrInConnections="10" nrOutConnections="10" inBandwidth="12" outBandwidth="12"/>
    </tile>
    <tile name="t3">
      <processor name="proc" type="arm7">
        <arbitration type="TDMA" wheelsize="100" contextSwitchOverhead="15" preemptive="true"/>
      </processor>
      <memory name="memt3" size="4000" type="shared"/>
      <networkInterface name="ni" nrInConnections="10" nrOutConnections="10" inBandwidth="12" outBandwidth="12"/>
    </tile>
    <connection name="con_1" srcTile="t1" srcNetworkInterface="ni" dstTile="t2" dstNetworkInterface="ni" latency="3"/>
    <connection name="con_2" srcTile="t1" srcNetworkInterface="ni" dstTile="t3" dstNetworkInterface="ni" latency="4"/>
    <connection name="con_3" srcTile="t2" srcNetworkInterface="ni" dstTile="t1" dstNetworkInterface="ni" latency="3"/>
    <connection name="con_4" srcTile="t2" srcNetworkInterface="ni" dstTile="t3" dstNetworkInterface="ni" latency="3"/>
    <connection name="con_5" srcTile="t3" srcNetworkInterface="ni" dstTile="t1" dstNetworkInterface="ni" latency="4"/>
    <connection name="con_6" srcTile="t3" srcNetworkInterface="ni" dstTile="t2" dstNetworkInterface="ni" latency="3"/>
  </architectureGraph>
