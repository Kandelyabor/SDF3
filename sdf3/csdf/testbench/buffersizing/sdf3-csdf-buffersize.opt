<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>CSDF analyze: buffersize on simple_example</name>
		<program>sdf3analyze-csdf --algo buffersize --graph simple_example.xml --output csdf-buffersize.xml</program>
		<type>outputcompare</type>
        <programTimeout>10</programTimeout>
		<programOutput>csdf-buffersize.xml</programOutput>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
