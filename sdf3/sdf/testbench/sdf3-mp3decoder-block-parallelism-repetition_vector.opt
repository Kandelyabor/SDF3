<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SDF analyze: repetition_vector on mp3 decoder block parallelism</name>
		<program>sdf3analyze-sdf --algo repetition_vector --graph mp3decoder_block_parallelism.xml</program>
		<type>outputcompare</type>
		<programOutput></programOutput>
		<reference>Repetition vector:
 [huffman] = 1
 [req0] = 2
 [reorder0] = 2
 [req1] = 2
 [reorder1] = 2
 [stereo] = 2
 [aliasreduct0] = 64
 [IMDCT0] = 192
 [freqinv0] = 192
 [synth0] = 2
 [aliasreduct1] = 64
 [IMDCT1] = 192
 [freqinv1] = 192
 [synth1] = 2</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
