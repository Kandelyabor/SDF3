    <style>        #header a {
            text-decoration: none;
            color: #6889b5;
            font-size: 20pt;
            font-weight: bold;
        }
        
        #nav-main {
            background-color: #4f6889;
            width: 100%;
            font-weight: bold;
            font-family: 'Luxi Sans', verdana, helvetica, arial, sans-serif;
            font-size: x-small;
            margin-top: 5px;
        }
        
        #nav-main-list {
            height: 20px; /* size of navigation bar */
            list-style: none;
            margin: 0px;
            padding: 0px;
        }
        
        #nav-main-list li {
            float: left;
            display: inline;
        }
        
        #nav-main-list a {
            color: #fff;
            text-decoration: none;
            vertical-align: middle;
            padding-left: 10px;
            padding-right: 10px;
            line-height: 20px;
            display: block;
        }
         
        #nav-main-list a:hover {
            background-color: #7ca3d6;
        } 
        
        #nav-main-list li strong{
            background-color: #6889b5;
            display: block;
        } 
        
        * html .nav-corner-br {
            margin-top: -12px;
        }
        
        * html .nav-corner-bl {
            margin-top: -12px;
        }
        
        body {
            margin: 0;
            padding: 0;
            text-align: center;
            font-family: 'Luxi Sans', 'Bitstream Vera Sans', 'Lucida Grande', 'Trebuchet MS', helvetica, verdana, arial, sans-serif;
            font-size: small;
            color: #333;
        }
        
        #mainone {
            min-width: 720px;
            padding-left: 30px;
            padding-right: 30px;
            margin-left: auto;
            margin-right: auto;
            text-align: left;
        }
        
        #site-left {
            width: 120px;
            float: left;
            margin-right: 20px;
        }
        
        #site-middle-two {
            margin-left: 140px;  /*width of site-left block */
        }
        
        #content {
            margin: 10px;
        }
        
        img {
            border: 0px;
        }
        
        div.center {
            text-align: center;
        }
        
        .command {
            font-family: 'Courier';
        }
        
        div.command {
            margin-top: 10px;
            margin-bottom: 10px;
            white-space: pre;
        }
        
        div.example {
            display: block;
            padding: 10px;
            border: 1px solid #6666cc;
            color: #000;
            overflow: auto;
            margin: 1em 2em;
        }
        
        code.screen, pre.screen {
            font-family: 'Courier';
            display: block;
            padding: 10px;
            border: 1px solid #bbb;
            background-color: #eee;
            color: #000;
            overflow: auto;
            margin: 1em 2em;
        }
        
        pre {
            font-size: 10pt;
        }
        
        img.right {
            display: block;
            float: right;
            margin: 10px;
        }
        
        img.left {
            display: block;
            float: left;
            margin: 10px;
        }
        
        p.right {
            text-align: right;
        }
        
        div.caution {
            display: block;
            padding: 10px;
            border: 1px solid #6666cc;
            background-color: #ccccff;
            color: #000;
            overflow: auto;
            margin: 1em 2em;
        }
        
        div.info {
            display: block;
            padding: 10px;
            border: 1px solid #6666cc;
            background-color: #ccccff;
            color: #000;
            overflow: auto;
            margin: 1em 2em;
        }
        
        th {
            color: #4f6889;
        }
        
        .header {
            color: #4f6889;
        }
        
        ul.separate li {
            margin-bottom: 10px;
        }
        
        ol.separate li {
            margin-bottom: 10px;
        }
        
        li.obsolete {
            color: #aaa;
        }
        
        div.tabs {
            width: 100%;
            height: 20px; /* size of navigation bar */
            list-style: none;
            margin: 0px;
            padding: 0px;
            
        }
        
        div.tabs ul {
            margin: 0px;
            padding: 0px;
        }
        
        div.tabs li {
            float: left;
            display: inline;
        }
        
        div.tabs a {
            color: #6f6f6f;
            text-decoration: none;
            padding-left: 0px;
            padding-right: 10px;
            line-height: 20px;
            display: block;
        }
         
        div.tabs a:hover {
            text-decoration: underline;
        } 
        
        #current{
            font-weight: bold;
            display: block;
        } 
        
        .center{
            text-align: center;
        } 
        td {
            padding-right: 30px;
        }
        
        th {
            padding-right: 30px;
        }
        .footer {
            font-size: x-small;
            color: #777;
            padding-top: 50px;
            padding-bottom: 30px;
            clear: both;
        }
        
        a.footer {
            text-decoration: none;
            color: #666699;
        }
        
        a.footer:visited {
            color: #666699;
        }
        
        a.footer:hover {
            text-decoration: underline;
            color: #666699;
        }
    </style>
</head>
