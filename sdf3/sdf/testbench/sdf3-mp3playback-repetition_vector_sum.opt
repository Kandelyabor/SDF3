<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SDF analyze: repetition_vector_sum on mp3playback</name>
		<program>sdf3analyze-sdf --algo repetition_vector_sum --graph mp3playback.xml</program>
		<type>outputcompare</type>
		<programOutput></programOutput>
		<reference>Repetition vector sum: 10601</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
