<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">
	<settings type="test">
		<name>SDF transform: retiming on modem</name>
		<program>sdf3transform-sdf --graph modem.xml --transform retiming --output sdf3-sdf-modem-retiming.xml</program>
		<type>xmlcompare</type>
		<programOutput>sdf3-sdf-modem-retiming.xml</programOutput>
	</settings>

</sdf3>
