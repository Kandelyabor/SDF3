<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SDF analyze: statistics on mp3 decoder granule parallelism</name>
		<program>sdf3analyze-sdf --algo statistics --graph mp3decoder_granule_parallelism.xml</program>
		<type>outputcompare</type>
		<programOutput></programOutput>
		<reference>#actors:          14
#channels:        21
#actors (HSDF):   27
#channels (HSDF): 41
</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
