<?xml version="1.0" encoding="UTF-8"?>
<sdf3 type="sdf" version="1.0"
    xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-sdf.xsd">
  <applicationGraph name="simplehsdf">
    <sdf name="simplehsdf" type="simplehsdf">
      <actor name="a" type="A">
        <port name="a_in" type="in" rate="1"/>
        <port name="a_out" type="out" rate="1"/>
        <port name="b_out" type="out" rate="1"/>
      </actor>
      <actor name="b" type="B">
        <port name="b_in" type="in" rate="1"/>
        <port name="b_out" type="out" rate="1"/>
        <port name="a_in" type="in" rate="1"/>
      </actor>
      <channel name="c" srcActor="a" srcPort="a_out" dstActor="a" dstPort="a_in" initialTokens="1"/>
      <channel name="d" srcActor="a" srcPort="b_out" dstActor="b" dstPort="a_in"/>
      <channel name="e" srcActor="b" srcPort="b_out" dstActor="b" dstPort="b_in" initialTokens="1"/>
    </sdf>
    <sdfProperties>
      <actorProperties actor="a">
        <processor type="p1" default="true">
          <executionTime time="3"/>
        </processor>
      </actorProperties>
      <actorProperties actor="b">
        <processor type="p1" default="true">
          <executionTime time="4"/>
        </processor>
      </actorProperties>
      <channelProperties channel="a"/>
      <channelProperties channel="b"/>
      <channelProperties channel="c"/>
    </sdfProperties>
  </applicationGraph>
</sdf3>
