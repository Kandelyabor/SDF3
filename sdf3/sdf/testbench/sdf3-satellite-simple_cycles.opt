<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SDF analyze: simple_cycles on satellite</name>
		<program>sdf3analyze-sdf --algo simple_cycles --graph satellite.xml</program>
		<type>outputcompare</type>
		<programOutput></programOutput>
		<reference>Simple cycles:
Cycle: a
Cycle: b
Cycle: c
Cycle: d
Cycle: e
Cycle: f
Cycle: g
Cycle: h
Cycle: i
Cycle: j
Cycle: k
Cycle: l
Cycle: m
Cycle: n
Cycle: p
Cycle: q
Cycle: r
Cycle: s
Cycle: t
Cycle: u
Cycle: v
Cycle: w</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
