<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SDF analyze: mcm(cycle) on mp3 decoder block parallelism</name>
		<program>sdf3analyze-sdf --algo mcm(cycle) --graph mp3decoder_block_parallelism.xml</program>
		<type>outputcompare</type>
		<programTimeout>20</programTimeout>
		<reference>MCM(mp3decoder) = 278650</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
