<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SDF analyze: latency min on strongly connected</name>
		<program>sdf3analyze-sdf --algo latency(min,in,out) --graph stronglyconnected.xml</program>
		<type>outputcompare</type>
		<programOutput></programOutput>
		<reference>latency(stronglyconnected) = 23
throughput(stronglyconnected) = 0.0333333</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
