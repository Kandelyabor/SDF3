<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SDF analyze: statistics on H263 encoder</name>
		<program>sdf3analyze-sdf --algo statistics --graph h263encoder.xml</program>
		<type>outputcompare</type>
		<programOutput></programOutput>
		<reference>#actors:          5
#channels:        7
#actors (HSDF):   201
#channels (HSDF): 399</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
