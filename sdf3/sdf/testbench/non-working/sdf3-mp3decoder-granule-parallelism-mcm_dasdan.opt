<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SDF analysis: mcm(dasdan) on mp3 decoder granule parallelism</name>
		<program>sdf3analysis-sdf --algo mcm(dasdan) --graph mp3decoder_granule_parallelism.xml</program>
		<type>outputcompare</type>
		<programOutput></programOutput>
		<reference>Graph is not strongly connected.</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
