<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SDF analyze: mpthroughput on mp3playback</name>
		<program>sdf3analyze-sdf --algo mpthroughput(maxNumberOfStates=1000) --graph mp3playback.xml</program>
		<type>outputcompare</type>
		<programOutput></programOutput>
		<reference>The maximum number of states will be limited to 1000
The maximum number of states was reached before finding a recurrent state.</reference>
		<ignore>analysis time: .*$</ignore>
	</settings>

</sdf3>
