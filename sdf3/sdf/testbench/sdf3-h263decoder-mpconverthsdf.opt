<?xml version="1.0" encoding="UTF-8"?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" type="fsmsadf" version="1.0" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-fsmsadf.xsd">

	<settings type="test">
		<name>SDF analyze: mpconverthsdf on H263 decoder</name>
		<program>sdf3analyze-sdf --algo mpconverthsdf --graph h263decoder.xml --output sdf3-sdf-h263decoder-mpconverthsdf-output.xml</program>
		<type>outputcompare</type>
		<programOutput>sdf3-sdf-h263decoder-mpconverthsdf-output.xml</programOutput>
		<ignore>analysis time: .*$</ignore>
	</settings>
</sdf3>
